{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NSE Breadth Ledger - Latest Metadata",
  "type": "object",
  "required": ["as_of_date", "as_of_timestamp", "data_status", "universe_size", "quarantined_count", "index_name"],
  "properties": {
    "as_of_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "as_of_timestamp": {"type": "string"},
    "data_status": {"type": "string", "enum": ["ok", "delayed", "quarantine_alert"]},
    "universe_size": {"type": "integer", "minimum": 1},
    "quarantined_count": {"type": "integer", "minimum": 0},
    "index_name": {"type": "string"},
    "total_universe_capacity": {"type": "integer"},
    "validation_passed": {"type": "boolean"},
    "disclaimer": {"type": "string"}
  }
}
